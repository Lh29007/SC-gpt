# Create a SoundCloud app at https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Must exactly match the callback URL registered in your SoundCloud app.
# Local default is http://localhost:3000/auth/callback.
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/auth/callback

# Protects MCP requests: Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# Protects the browser-based /auth/start page (HTTP Basic password).
AUTH_SETUP_KEY=

# Render supplies PORT automatically.
PORT=3000
